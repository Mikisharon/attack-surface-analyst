# Copy this file to .env and fill in your values. .env is never committed.

# Claude API key from https://console.anthropic.com/ (optional: without it,
# the LLM steps run with an offline heuristic stand-in and the run says so).
ANTHROPIC_API_KEY=

# Which Claude model the LLM agents use. Default: claude-opus-5-5.
# claude-haiku-5-5 is much cheaper and helps meet the PRD's < $0.10 per run target.
ASA_MODEL=claude-opus-5-5

# Model for `--llm claude-code` (Claude via Claude Code on your Pro/Max plan, no API
# billing). An alias such as sonnet, opus or haiku. Default: sonnet.
# Leave ANTHROPIC_API_KEY empty when you use this mode.
ASA_CLAUDE_CODE_MODEL=sonnet

# Optional free NVD API key (https://nvd.nist.gov/developers/request-an-api-key).
# Raises the NVD rate limit, so Threat Intel waits less between lookups.
NVD_API_KEY=
